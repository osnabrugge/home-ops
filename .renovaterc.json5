{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#10.0.1",
    "github>home-operations/renovate-presets//apps/cnpg.json5#10.0.1",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#10.0.1",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.1",
    ":timezone(America/Toronto)",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  // The externally published ocharted registry requires the credentials injected
  // by .github/workflows/renovate.yaml; an in-cluster proxy address is not a bypass.
  hostRules: [
    {
      description: "Authenticate against the ocharted OCI registry",
      matchHost: "ocharted.homeops.ca",
      hostType: "docker",
      username: "{{ secrets.OCHARTED_USERNAME }}",
      password: "{{ secrets.OCHARTED_PASSWORD }}",
    },
  ],
  // LibreNMS has no Flux wiring or chart source yet, so its updates cannot deploy.
  ignorePaths: ["kubernetes/apps/observability/librenms/**"],
  // Add to the preset's custom managers; image-volume references need their own capture.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "image:\\s*\\n\\s*reference:\\s*[\"']?(?<depName>[^\"'\\s:]+):(?<currentValue>[^\"'\\s@]+)[\"']?",
      ],
      datasourceTemplate: "docker",
    },
  ],
  // The Main ruleset does not require up-to-date branches, and `auto` would
  // still rebase every automerge PR each time main moves
  rebaseWhen: "conflicted",
  packageRules: [
    // ocharted serves manifests by tag only; digest-addressed pulls return 404.
    {
      description: "ocharted serves by tag only - never pin digests on it",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.homeops.ca/**"],
      pinDigests: false,
    },
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      description: "Netbox Diode Group",
      groupName: "netbox-diode",
      matchDatasources: ["docker"],
      matchPackageNames: ["/diode-auth/", "/diode-ingester/", "/diode-reconciler/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Printstash Group",
      groupName: "printstash",
      matchDatasources: ["docker"],
      matchPackageNames: ["/printstash-api/", "/printstash-frontend/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // Unites the factory installer image and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Toolhive-Operator Group",
      groupName: "toolhive-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive-operator/", "/toolhive-operator-crds/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // A merged Talos bump triggers tuppr to power-cycle all six nodes.
      description: "Never auto-bump Talos minor/major -- tuppr reboots the whole cluster",
      matchPackageNames: ["siderolabs/talos"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}

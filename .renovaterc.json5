{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    ":timezone(America/Toronto)",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  // ocharted is only a pull-through cache and is reached over a cluster-internal
  // Service, so it needs no credentials from CI and must not be queried from CI.
  // The charts behind it are tracked against their upstream Helm repos below.
  hostRules: [],
  // librenms is an unfinished scaffold: it has a helmrelease.yaml but no ks.yaml,
  // no ocirepository.yaml for the chartRef it names, and is not referenced by
  // kubernetes/apps/observability/kustomization.yaml. Renovate PRs against it can
  // never render or deploy. Remove this entry once the app is fully wired up.
  ignorePaths: ["kubernetes/apps/observability/librenms/**"],
  // `customManagers` is mergeable, so these are ADDED to the two in
  // home-operations/renovate-presets rather than replacing them.
  customManagers: [
    {
      // A Kubernetes image volume pins its image on `reference:`, which no
      // built-in manager reads, and the preset's `# renovate:` annotation
      // manager captures the whole `repo:tag` string as currentValue - so
      // neither can update it. Without this, etcd-defrag's talosctl would
      // silently drift behind the nodes (it was already a minor behind).
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "image:\\s*\\n\\s*reference:\\s*[\"']?(?<depName>[^\"'\\s:]+):(?<currentValue>[^\"'\\s@]+)[\"']?",
      ],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // ocharted only bypasses auth for 10.42.0.0/16, so a lookup from CI returns
      // no-result. Query the upstream Helm repo it proxies instead. Keep these
      // matchers in sync with the OCIRepository url or updates silently stop.
      description: "Track radar against its upstream Helm repo, not the ocharted proxy",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.homeops.ca/skyhook-io.github.io/helm-charts/radar"],
      overrideDatasource: "helm",
      overridePackageName: "radar",
      registryUrls: ["https://skyhook-io.github.io/helm-charts"],
      // ocharted serves manifests by TAG only; a digest-addressed fetch 404s, so a
      // pinned digest makes the OCIRepository permanently unready (broke PR #4169).
      pinDigests: false,
    },
    {
      description: "Track ceph-csi-drivers against its upstream Helm repo, not the ocharted proxy",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.homeops.ca/ceph.github.io/ceph-csi-operator/ceph-csi-drivers"],
      overrideDatasource: "helm",
      overridePackageName: "ceph-csi-drivers",
      registryUrls: ["https://ceph.github.io/ceph-csi-operator"],
      pinDigests: false,
    },
    {
      // ⛔ THIS DOES NOT WORK. Kept only to document the dead end.
      // `pinDigests` is the WRONG KNOB: it governs whether Renovate *pins* a digest
      // on an otherwise-unpinned dep. The bare-hex digest here is not a pin — the
      // flux manager writes `ref.digest` as part of an ordinary version bump, copying
      // the `digest:` field out of the upstream Helm index.yaml (bare hex, no
      // `sha256:` prefix), which source-controller rejects: `cannot parse hash`.
      // Re-added by #4290 (1.13.x) and again by #4306 (1.14.0 -> 1.14.1) AFTER the
      // matchFileNames rule below was added. Stripped in 166cf7d30, again, and again.
      //
      // ROOT CAUSE: `overrideDatasource: "helm"` above. It exists only because
      // ocharted.homeops.ca is published on envoy-INTERNAL, so a GitHub-hosted runner
      // cannot reach it and `hostRules` had to be emptied. onedr0p has the same proxy
      // but his ocharted.turbo.ac is publicly reachable, so he authenticates with a
      // hostRule, stays on the docker datasource, and needs NO pinDigests rule at all —
      // all four of his ocharted OCIRepositories are tag-only with no digest.
      //
      // DURABLE FIX (needs a decision): publish ocharted externally like onedr0p and
      // restore the hostRule + OCHARTED_USERNAME/OCHARTED_PASSWORD, then delete the two
      // overrideDatasource rules above. Until then a digest WILL come back on the next
      // radar/ceph-csi-drivers version bump and must be stripped by hand.
      description: "Never pin digests on ocharted-backed OCIRepositories (INEFFECTIVE - see comment)",
      matchFileNames: [
        "kubernetes/apps/observability/radar/app/ocirepository.yaml",
        "kubernetes/apps/rook-ceph/ceph-csi-drivers/app/ocirepository.yaml",
      ],
      pinDigests: false,
    },
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      description: "Netbox Diode Group",
      groupName: "netbox-diode",
      matchDatasources: ["docker"],
      matchPackageNames: ["/diode-auth/", "/diode-ingester/", "/diode-reconciler/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Printstash Group",
      groupName: "printstash",
      matchDatasources: ["docker"],
      matchPackageNames: ["/printstash-api/", "/printstash-frontend/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // After the mise tools catch-all so talos wins its own group; unites the
      // mise pin, the factory installer image, and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Toolhive-Operator Group",
      groupName: "toolhive-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive-operator/", "/toolhive-operator-crds/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // A merged Talos bump is not a PR, it is an unattended rolling power-cycle
      // of all 6 nodes via tuppr. 1.13->1.14 renumbered /dev/dri and broke every
      // GPU workload. Raise this deliberately, with a maintenance window.
      description: "Never auto-bump Talos minor/major -- tuppr reboots the whole cluster",
      matchPackageNames: ["siderolabs/talos"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },
    {
      description: "CoreDNS 1.14.3+ prefetch poisons autopath answers, hold until coredns/coredns#8390 is fixed",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/coredns/charts/coredns"],
      enabled: false,
    },
    {
      // hedless/onshape-mcp declares mcp>=0.1.0 but its code targets the v1 SDK.
      // v2 removed Server.list_tools(), so the container dies on import with
      // AttributeError. #3959 (1.17.0 -> 2.0.0) broke it on 2026-08-23 and it
      // crashlooped until 2026-09-23. Verified: mcp 1.17.0 on python 3.14 still
      // exposes the decorator.
      description: "onshape-mcp targets the v1 mcp SDK -- v2 removed Server.list_tools()",
      matchDatasources: ["pypi"],
      matchPackageNames: ["mcp"],
      allowedVersions: "<2",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}

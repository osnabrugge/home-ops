{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Pin 7.0.0. Earlier tags are permanently broken by design: 5.0.0 and 6.0.0 both
  // carry UNPINNED nested references (//managers/cnpg.json5, //config/baseConfig.json5)
  // which resolve against the preset repo's default branch rather than the tag. When
  // upstream restructured - deleting config/, managers/, overrides/ and policies/ from
  // main - every one of those tags broke retroactively and Renovate halted all PRs.
  // 7.0.0 consolidated everything into a self-contained default.json with zero
  // references back to its own repo, so no upstream move can break it.
  extends: [
    "github>home-operations/renovate-presets#7.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#7.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#7.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#7.0.0",
    ":timezone(America/Toronto)",
  ],
  // Jinja templates are not valid YAML - the {% if %} blocks make Renovate's YAML
  // parser throw on every run. They carry no renovatable dependencies anyway.
  ignorePaths: ["talos/**/*.j2"],
  // GitHub's GraphQL API intermittently returns 502s when Renovate fetches PR
  // changelogs, which causes the workflow to fail with external-host-error.
  // Disable changelog fetching to keep scheduled runs resilient to that outage.
  fetchChangeLogs: "off",
  packageRules: [
    {
      description: "Pin maddy: upstream 0.9.5+ has broken/missing layer blobs on ghcr.io (404 on pull)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/foxcpp/maddy"],
      enabled: false,
    },
    {
      description: "Pin quay.io/ceph/ceph: Ceph major upgrades must be co-ordinated with a Rook operator release that explicitly supports the new Ceph major. Re-enable once Rook v1.21 ships with Ceph v21 support.",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/ceph/ceph"],
      enabled: false,
    },
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}

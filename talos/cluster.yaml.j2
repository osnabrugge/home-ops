---
version: v1alpha1
machine:
  ca:
    crt: azkv://keyvault-kube/talos#MACHINE_CA_CRT
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    rbac: true
  token: azkv://keyvault-kube/talos#MACHINE_TOKEN
cluster:
  ca:
    crt: azkv://keyvault-kube/talos#CLUSTER_CA_CRT
  clusterName: main
  controlPlane:
    endpoint: https://k8s.in.homeops.ca:6443
  token: azkv://keyvault-kube/talos#CLUSTER_TOKEN
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - enp1s0f0
  - enp1s0f1
bondMode: 802.3ad
miimon: 100
updelay: 200
downdelay: 200
xmitHashPolicy: layer3+4
lacpRate: fast
mtu: 1500
---
apiVersion: v1alpha1
kind: EthernetConfig
name: bond0
features:
  rx-gro-list: off
  rx-udp-gro-forwarding: on
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp1s0f0
rings:
  rx: 8160
  tx: 8160
features:
  rx-gro-list: off
  rx-udp-gro-forwarding: on
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp1s0f1
rings:
  rx: 8160
  tx: 8160
features:
  rx-gro-list: off
  rx-udp-gro-forwarding: on
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.1
vlanID: 1
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.50
vlanID: 50
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.70
vlanID: 70
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.99
vlanID: 99
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
  domains: []
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true # Requires Cilium socketLB features
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: azkv://keyvault-kube/talos#CLUSTER_ID
clusterSecret: azkv://keyvault-kube/talos#CLUSTER_SECRET
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer-secureboot/{{ schematic }}:v1.14.5
provisioning:
  diskSelector:
    match: disk.model == "DOGFISH SSD 256G"
  wipe: false
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_thin_pool
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.ip_local_port_range: 1024 65535
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.ping_group_range: 0 2147483647
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_notsent_lowat: "131072"
  net.ipv4.tcp_rmem: 4096 131072 67108864
  net.ipv4.tcp_slow_start_after_idle: "0"
  net.ipv4.tcp_window_scaling: "1"
  net.ipv4.tcp_wmem: 4096 65536 67108864
  net/ipv6/conf/bond0.70/disable_ipv6: "1" # keep the host off IPv6 on the IoT segment
  sunrpc.tcp_max_slot_table_entries: "128"
  sunrpc.tcp_slot_table_entries: "128"
  user.max_user_namespaces: "11255"
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfs.conf
mode: 0o644
contents: |
  [nfsrahead]
  nfs4=16384
  default=128
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  # TODO: Change to nfsvers=4.2 after migrating from Synology DS1821+ to Supermicro NAS
  # Synology explicitly blocks NFS v4.2 connections
  nfsvers=4.1
  hard=True
  nconnect=16
  noatime=True
  rsize=1048576
  wsize=1048576
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 192.168.42.0/24
labels:
  node.kubernetes.io/gpu: "true"
  topology.kubernetes.io/region: main
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  # Image GC must free space BEFORE the Ceph mon complains. A mon warns at
  # <30% avail (i.e. 70% used); kubelet's default high threshold of 85% meant
  # images grew past the mon warning and never got collected. Age-based GC is
  # off by default (0s), so stale images accumulated
  imageGCHighThresholdPercent: 70
  imageGCLowThresholdPercent: 55
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  serializeImagePulls: false
  shutdownGracePeriod: 90s
  shutdownGracePeriodCriticalPods: 60s
defaultRuntimeSeccompProfileEnabled: true
image: ghcr.io/siderolabs/kubelet:v1.37.1
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.42.0.0/16
serviceSubnets:
  - 10.43.0.0/16
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: ExtensionServiceConfig
name: lldpd
configFiles:
  - content: |
      configure lldp portidsubtype ifname
      configure system description "Talos Node"
    mountPath: /usr/local/etc/lldpd/lldpd.conf
